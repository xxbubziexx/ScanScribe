# Timezone (use your local timezone)
# List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Chicago

# Security (DO NOT commit to git!)
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours (default), adjust as needed

# Container Paths (rarely changed)
INGEST_DIR=/app/ingest
OUTPUT_DIR=/app/audio_storage
LOG_DIR=/app/logs
DB_PATH=/app/data/scanscribe.db
CONFIG_PATH=/app/config.yml

# PyTorch CPU Optimization
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
TORCH_NUM_THREADS=4

# OpenRouter Configuration (Events Pipeline & Hourly Summaries)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash

# Default Admin Password (REQUIRED for initial setup)
# The system will automatically create an admin account with username "admin" on startup.
# Once created, you should change this password in the UI or remove it from here.
SCANSCRIBE_DEFAULT_ADMIN_PASSWORD=change-me-immediately

# Geocoding Configuration (Command Center Map)
# By default, ScanScribe uses OpenStreetMap Nominatim (free, no key required).
# To use Google Maps or Mapbox, uncomment and provide your API key.
# GEOCODE_PROVIDER=google
# GOOGLE_MAPS_API_KEY=your-google-maps-key
# GEOCODE_PROVIDER=mapbox
# MAPBOX_ACCESS_TOKEN=your-mapbox-token
